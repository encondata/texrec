# copy to .env next to docker-compose.yml and edit

# --- web (the only service exposed publicly) ---
HOST_PORT=80
# bind to a specific host IP (default: all interfaces)
BIND_IP=0.0.0.0
# the address visitors use; used in emails and Stripe redirects
PUBLIC_URL=http://localhost

# --- app ---
# random 32+ char string; encrypts secrets stored in the database (openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string
# first admin account, created on first boot only if no admins exist
BOOTSTRAP_ADMIN_EMAIL=admin@texrec.com
BOOTSTRAP_ADMIN_PASSWORD=pick-a-strong-admin-password
BOOTSTRAP_ADMIN_NAME=TexRec Admin
# 1 = load demo courses/staff/events/posts into an EMPTY database on first boot
SEED_DEMO=0

# --- database ---
PGDATABASE=texrec
PGUSER=texrec
PGPASSWORD=pick-a-strong-db-password

# --- object storage (MinIO) ---
MINIO_ROOT_USER=texrec
MINIO_ROOT_PASSWORD=pick-a-strong-minio-password
S3_BUCKET=texrec
# MinIO admin console; keep on 127.0.0.1 unless you need remote access
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

# --- dev mail catcher UI ---
MAILPIT_BIND=127.0.0.1
MAILPIT_PORT=8025
